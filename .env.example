LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_BASE_URL=
STT_PROVIDER=local
STT_MODEL=tiny
TTS_PROVIDER=edge
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
DENSE_RETRIEVER=faiss
